{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication ACH Returns Health API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sandbox.rainforestpay.com/health"
          },
          "docs": "Get the status of the Rainforest API."
        }
      ]
    }
  ],
  "bundled": true
}