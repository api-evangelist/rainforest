        {
          "id": "859c0b1a-5530-4aea-9741-5df736f6bfb4",
          "name": "Simulate payin ACH return",
          "request": {
            "name": "Simulate payin ACH return",
            "description": {
              "content": "Only available in the Rainforest sandbox environment.\n\nMay only be called on an ACH payin in `PROCESSING` or `SUCCEEDED` statuses. An ACH return must not have already been created for the payin.\n\nThe expected webhooks will be sent as the payin's status is advanced and when the ACH return is created.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "payins",
