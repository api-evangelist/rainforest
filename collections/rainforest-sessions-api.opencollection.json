{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication ACH Returns Sessions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sessions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sandbox.rainforestpay.com/v1/sessions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a temporary session to delegate permissions to a third-party."
        },
        {
          "info": {
            "name": "Delete session",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.sandbox.rainforestpay.com/v1/sessions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete a temporary session, permanently invalidating it."
        }
      ]
    }
  ],
  "bundled": true
}