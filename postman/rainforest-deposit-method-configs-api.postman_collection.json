                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"deposit_method_config_id\": \"<string>\",\n  \"platform_id\": \"<string>\",\n  \"idempotency_key\": \"<string>\",\n  \"billing_contact\": {\n    \"value\": \"reference #/paths/~1v1~1deposit_methods/post/requestBody/content/application~1json/schema/properties/billing_contact not found in the OpenAPI spec\"\n  },\n  \"allowed_sources\": [\n    \"PARTNER_PLAID\",\n    \"ENCRYPTED_ACH\"\n  ],\n  \"metadata\": {},\n  \"created_at\": \"<dateTime>\"\n}",
